# ══════════════════════════════════════════════════════════════════════════════
# .gitignore — ART FASHION Monorepo (pnpm + Turborepo + Vite)
# @author @hopsyder | Nexus Partners
# ══════════════════════════════════════════════════════════════════════════════

# ─── Dépendances ──────────────────────────────────────────────────────────────
node_modules/
jspm_packages/
.pnpm-store/

# ─── Build / Dist ─────────────────────────────────────────────────────────────
dist/
dist-ssr/
build/
out/
.next/
.nuxt/
*.local

# ─── Cache Turborepo / Vite / TypeScript ─────────────────────────────────────
.turbo/
.vite/
*.tsbuildinfo

# ─── Logs ─────────────────────────────────────────────────────────────────────
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# ─── Runtime / Processus ──────────────────────────────────────────────────────
pids/
*.pid
*.seed
*.pid.lock
report.[0-9]*.[0-9]*.[0-9]*.[0-9]*.json

# ─── Tests / Couverture ───────────────────────────────────────────────────────
coverage/
.nyc_output/

# ─── Variables d'environnement (SECRETS) ─────────────────────────────────────
.env
.env.*
!.env.example

# ─── Fichiers de configuration sensibles / Déploiement ───────────────────────
scripts/deploy.mjs
scripts/deploy-ovh-ftp.py
apps/storefront/public/api/_config.php
apps/upload-server/.env

# ─── Base de données locale ───────────────────────────────────────────────────
db.json

# ─── Archives / Backups auto ──────────────────────────────────────────────────
*.bak
*.backup
.dexty/backups/
*.sql.gz

# ─── Paquets npm ─────────────────────────────────────────────────────────────
*.tgz
.yarn-integrity
.npm/
.eslintcache
.node_repl_history

# ─── OS ───────────────────────────────────────────────────────────────────────
.DS_Store
.DS_Store?
._*
Thumbs.db
ehthumbs.db
desktop.ini

# ─── Éditeurs ─────────────────────────────────────────────────────────────────
.idea/
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
!.vscode/launch.json
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
*.swp
*.swx

# ─── SFTP / Déploiement VS Code ───────────────────────────────────────────────
.vscode/sftp.json
apps/*/.vscode/sftp.json

# ─── Agents IA / Assistants ───────────────────────────────────────────────────
.dexty/
.gemini/
.claude/
.cursor/

# ─── Docker (fichiers locaux) ─────────────────────────────────────────────────
docker-compose.override.yml
.docker/

# ─── Divers ───────────────────────────────────────────────────────────────────
*.zip
*.tar.gz
.storybook/
storybook-static/
