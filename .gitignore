# ══════════════════════════════════════════════════════════════════════════════
# .gitignore — ART FASHION Monorepo (pnpm + Turborepo + Vite)
# @author @hopsyder | Nexus Partners
# ══════════════════════════════════════════════════════════════════════════════

# ─── Dépendances ──────────────────────────────────────────────────────────────
node_modules/
.pnpm-store/
jspm_packages/

# ─── Build / Dist ─────────────────────────────────────────────────────────────
dist/
dist-ssr/
build/
out/
.next/
.nuxt/
*.local

# ─── Cache Turborepo / Vite / TypeScript ─────────────────────────────────────
.turbo/
**/.turbo/
.vite/
**/.vite/
*.tsbuildinfo
.eslintcache

# ─── Logs ─────────────────────────────────────────────────────────────────────
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# ─── Runtime / Processus / Fichiers temporaires ───────────────────────────────
pids/
*.pid
*.seed
*.pid.lock
*.tmp
*.tmp.*
report.[0-9]*.[0-9]*.[0-9]*.[0-9]*.json

# ─── Tests / Couverture ───────────────────────────────────────────────────────
coverage/
.nyc_output/

# ─── Variables d'environnement & Secrets ──────────────────────────────────────
.env
.env.*
!.env.example
!.env*.example
*.pem
*.key
*.cert
*.pfx

# ─── Fichiers de configuration sensibles & Déploiement ────────────────────────
apps/storefront/public/api/_config.php
apps/storefront/dist/api/_config.php
apps/upload-server/.env
scripts/deploy.mjs
deploy.mjs
deploy.env
deploy-secrets.*

# ─── Base de données locale & Données SQLite ──────────────────────────────────
/db.json
*.sqlite
*.sqlite3
*.db

# ─── Uploads / Médias générés localement ──────────────────────────────────────
uploads/
**/uploads/*
!**/uploads/.gitkeep

# ─── Archives / Backups automatiques ──────────────────────────────────────────
*.bak
*.backup
*.sql.gz
*.tar.gz
*.zip

# ─── Agents IA & Outils d'assistance ──────────────────────────────────────────
.dexty/
.gemini/
.claude/
.cursor/

# ─── Éditeurs & IDE ───────────────────────────────────────────────────────────
.idea/
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
!.vscode/launch.json
.vscode/sftp.json
apps/*/.vscode/sftp.json
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
*.swp
*.swx

# ─── Système d'exploitation ───────────────────────────────────────────────────
.DS_Store
.DS_Store?
._*
Thumbs.db
ehthumbs.db
desktop.ini

# ─── Docker (surcharges locales) ──────────────────────────────────────────────
docker-compose.override.yml
.docker/

# ─── Paquets npm locaux ───────────────────────────────────────────────────────
*.tgz
.yarn-integrity
.npm/
.node_repl_history
